      subgraph T1["Proactor 1（OS 线程）"]
        C1["Connection Fiber B"]
        Q1["高优先级 shard_queue_1 Fiber"]
        S1["EngineShard 1<br/>DbSlice 1"]
      end

      subgraph TN["其余 Proactor 线程"]
        CN["更多 Connection / 后台 Fiber"]
      end
    end

    C -->|"TCP / UDS"| A0
    A0 -->|"选择连接 Proactor"| C0
    A0 -->|"也可能选择其他线程"| C1
