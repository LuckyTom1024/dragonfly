    subgraph F1["Proactor 1"]
      X1["flow 1 full/stable read Fiber"]
      A1["flow 1 ack Fiber"]
    end
    subgraph FN["其他 Proactor"]
      XN["更多 flow Fibers"]
    end

    J["JournalReader / RdbLoader"]
    T["Transaction / EngineShard 应用数据"]

    A --> B --> C
    C -->|Redis master| R --> T
